      "parameters": {
        "jsCode": "const tables = $input.all().map(i => i.json).filter(Boolean);\nconst total_inserted = tables.reduce((s,t) => s + (t.inserted || 0), 0);\nconst total_updated  = tables.reduce((s,t) => s + (t.updated  || 0), 0);\nconst total_errors   = tables.reduce((s,t) => s + (t.errors   || 0), 0);\nconst status = total_errors === 0 ? 'success' : 'partial';\nconsole.log(`[WF-08] ✅ Sync Gold → BC terminé: ${total_inserted} inserts | ${total_updated} updates | ${total_errors} errors`);\nreturn [{ json: { status, tables, total_inserted, total_updated, total_errors, completedAt: new Date().toISOString() } }];"
