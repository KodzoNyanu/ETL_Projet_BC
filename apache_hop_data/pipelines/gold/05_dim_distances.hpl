<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05_dim_distances</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Charge dim_distances (sessions GPS) depuis silver.distance_matrix vers PostgreSQL Gold</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/06/03 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/06/03 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read from silver.distance_matrix</from><to>Parse types</to><enabled>Y</enabled></hop>
    <hop><from>Parse types</from><to>Load dim_distances</to><enabled>Y</enabled></hop>
  </order>

  <transform>
    <name>Read from silver.distance_matrix</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <sql>SELECT session_id, session_date, total_distance_km, total_distance_meters,
  max_speed_kmh, avg_speed_kmh, total_active_seconds, event_count,
  first_event_at AS first_event_at_str, last_event_at AS last_event_at_str
FROM silver.distance_matrix</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform>
    <name>Parse types</name>
    <type>ScriptValueMod</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Parse types</jsScript_name>
        <jsScript_script><![CDATA[
function parseISO(s) {
    if (!s) return null;
    try {
        var f = new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'");
        f.setTimeZone(java.util.TimeZone.getTimeZone("UTC"));
        return f.parse(s);
    } catch(e) {
        try {
            var f2 = new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'");
            f2.setTimeZone(java.util.TimeZone.getTimeZone("UTC"));
            return f2.parse(s);
        } catch(e2) { return null; }
    }
}
var first_event_at = parseISO(first_event_at_str);
var last_event_at  = parseISO(last_event_at_str);
var dist_km    = total_distance_km    != null ? parseFloat(String(total_distance_km))    : null;
var dist_m     = total_distance_meters != null ? parseFloat(String(total_distance_meters)) : null;
var max_spd    = max_speed_kmh        != null ? parseFloat(String(max_speed_kmh))        : null;
var avg_spd    = avg_speed_kmh        != null ? parseFloat(String(avg_speed_kmh))        : null;
var act_secs   = total_active_seconds != null ? parseInt(String(total_active_seconds))   : null;
var evt_cnt    = event_count          != null ? parseInt(String(event_count))            : null;
]]></jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>dist_km</name><rename>total_distance_km_val</rename><type>BigNumber</type><length>10</length><precision>4</precision><replace>N</replace></field>
      <field><name>dist_m</name><rename>total_distance_meters_val</rename><type>BigNumber</type><length>10</length><precision>2</precision><replace>N</replace></field>
      <field><name>max_spd</name><rename>max_speed_kmh_val</rename><type>BigNumber</type><length>10</length><precision>3</precision><replace>N</replace></field>
      <field><name>avg_spd</name><rename>avg_speed_kmh_val</rename><type>BigNumber</type><length>10</length><precision>3</precision><replace>N</replace></field>
      <field><name>act_secs</name><rename>total_active_seconds_val</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>evt_cnt</name><rename>event_count_val</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>first_event_at</name><rename>first_event_at</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>last_event_at</name><rename>last_event_at</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform>
    <name>Load dim_distances</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <schema>public</schema>
    <table>dim_distances</table>
    <commit>100</commit>
    <truncate>Y</truncate>
    <ignore>N</ignore>
    <specify_fields>Y</specify_fields>
    <onlyWhenHaveRows>N</onlyWhenHaveRows>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>session_id</column_name><stream_name>session_id</stream_name></field>
      <field><column_name>session_date</column_name><stream_name>session_date</stream_name></field>
      <field><column_name>total_distance_km</column_name><stream_name>total_distance_km_val</stream_name></field>
      <field><column_name>total_distance_meters</column_name><stream_name>total_distance_meters_val</stream_name></field>
      <field><column_name>max_speed_kmh</column_name><stream_name>max_speed_kmh_val</stream_name></field>
      <field><column_name>avg_speed_kmh</column_name><stream_name>avg_speed_kmh_val</stream_name></field>
      <field><column_name>total_active_seconds</column_name><stream_name>total_active_seconds_val</stream_name></field>
      <field><column_name>event_count</column_name><stream_name>event_count_val</stream_name></field>
      <field><column_name>first_event_at</column_name><stream_name>first_event_at</stream_name></field>
      <field><column_name>last_event_at</column_name><stream_name>last_event_at</stream_name></field>
    </fields>
    <attributes/>
    <GUI><xloc>640</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
