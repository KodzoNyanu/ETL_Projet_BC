<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05_silver_distances</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Charge les sessions GPS temps réel depuis /staging/enrichment/distances_realtime.json vers silver.distance_matrix</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/06/03 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/06/03 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read distances_realtime JSON</from><to>Load silver.distance_matrix</to><enabled>Y</enabled></hop>
  </order>

  <!-- Source : fichier JSON produit par WF-04B (webhook distance app)
       Format : { "data": [ { "session_id":..., "total_distance_km":..., ... } ] } -->
  <transform>
    <name>Read distances_realtime JSON</name>
    <type>JsonInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <isAFile>N</isAFile>
    <isInFields>N</isInFields>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rowLimit>0</rowLimit>
    <encoding>UTF-8</encoding>
    <file>
      <name>/staging/enrichment/distances_realtime.json</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field><name>session_id</name><path>$.data[*].session_id</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>session_date</name><path>$.data[*].session_date</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>total_distance_km</name><path>$.data[*].total_distance_km</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>total_distance_meters</name><path>$.data[*].total_distance_meters</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>max_speed_kmh</name><path>$.data[*].max_speed_kmh</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>avg_speed_kmh</name><path>$.data[*].avg_speed_kmh</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>total_active_seconds</name><path>$.data[*].total_active_seconds</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>event_count</name><path>$.data[*].event_count</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>first_event_at</name><path>$.data[*].first_event_at</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>last_event_at</name><path>$.data[*].last_event_at</path><type>String</type><format/><length>-1</length><precision>-1</precision><currency/><decimal/><group/><trim_type>both</trim_type><repeat>N</repeat></field>
    </fields>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform>
    <name>Load silver.distance_matrix</name>
    <type>TableOutput</type>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <schema>silver</schema>
    <table>distance_matrix</table>
    <commit>100</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>session_id</column_name><stream_name>session_id</stream_name></field>
      <field><column_name>session_date</column_name><stream_name>session_date</stream_name></field>
      <field><column_name>total_distance_km</column_name><stream_name>total_distance_km</stream_name></field>
      <field><column_name>total_distance_meters</column_name><stream_name>total_distance_meters</stream_name></field>
      <field><column_name>max_speed_kmh</column_name><stream_name>max_speed_kmh</stream_name></field>
      <field><column_name>avg_speed_kmh</column_name><stream_name>avg_speed_kmh</stream_name></field>
      <field><column_name>total_active_seconds</column_name><stream_name>total_active_seconds</stream_name></field>
      <field><column_name>event_count</column_name><stream_name>event_count</stream_name></field>
      <field><column_name>first_event_at</column_name><stream_name>first_event_at</stream_name></field>
      <field><column_name>last_event_at</column_name><stream_name>last_event_at</stream_name></field>
    </fields>
    <attributes/>
    <GUI><xloc>420</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
